# Copy to .env and replace the placeholders with local values.
DATABASE_URL=mysql+pymysql://fleet_user:replace_me@127.0.0.1:3306/fleet_db
# Generate a unique random secret before running the application.
SECRET_KEY=replace_with_a_unique_random_secret_before_starting
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
